# Backend environment example
# Copy this file to .env inside the backend folder and adjust values.

# --- Servidor ---
PORT=3001
NODE_ENV=development

# --- Base de datos ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/biblioteka_dev?schema=public

# --- Auth ---
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Correo (Nodemailer + Gmail) ---
# BREVO_API_KEY existe por compatibilidad pero NO se usa en el código actual.
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
BREVO_API_KEY=tu_api_key_aqui

# --- Mercado Pago ---
# Usa credenciales de PRUEBA (empiezan con TEST-) mientras el proyecto
# esté en modo demo/calificación. No generan cargos reales.
MERCADOPAGO_ACCESS_TOKEN=TEST-tu-access-token-de-prueba
BACKEND_PUBLIC_URL=https://dynamic-charm-production-3133.up.railway.app
FRONTEND_PUBLIC_URL=https://bibliotecas-app-production-7dc0.up.railway.app